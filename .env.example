# Supabase → Connect → Direct connection string → Transaction pooler (puerto 6543)
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase → Connect → Session pooler (puerto 5432)
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Usuario y clave para abrir la app (todos)
PEDIDOS_BASIC_USER=""
PEDIDOS_BASIC_PASS=""
# Clave de sincronización (todos)
PEDIDOS_SYNC_KEY=""
# Clave de la oficina: publicar precios, catálogo, clientes y cerrar cargas (solo oficina)
PEDIDOS_ADMIN_KEY=""
# Clave de supervisor: ve todo (pedidos, clientes, historial, reportes) pero
# nunca puede crear, editar ni eliminar nada. Opcional: si se deja vacía, el
# acceso de supervisor queda deshabilitado.
PEDIDOS_SUPERVISOR_KEY=""
