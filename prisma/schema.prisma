generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Almacén de documentos sincronizados: espejo 1:1 de los stores de IndexedDB
// del cliente. `data` guarda el documento JSON completo; las demás columnas son índices.
model DistDoc {
  kind      String   // orders | clients | products | sellers | loads | config
  id        String
  data      String   // JSON del documento
  sellerId  String?  // pedidos, clientes y cargas: filtra la bajada por vendedor
  routeDate String?  // solo pedidos: YYYY-MM-DD
  status    String?  // solo pedidos: abierto | enviado | despachado
  deleted   Boolean  @default(false)
  updatedAt String   // updatedAt del cliente (ISO) → last-write-wins
  syncedAt  DateTime @default(now()) @updatedAt // cursor de sincronización

  @@id([kind, id])
  @@index([kind, syncedAt])
  @@index([kind, sellerId, routeDate])
}

// Numeración de cargas y notas de entrega. La entrega el servidor de forma
// atómica: dos PCs de oficina nunca imprimen el mismo número.
model DistCounter {
  name  String @id // load | note
  value Int    @default(0)
}

// Suscripciones a notificaciones push (una por equipo y rol). El teléfono las
// recibe aunque la app esté cerrada o la pantalla bloqueada.
model DistPush {
  endpoint  String   // URL del servicio push del navegador
  role      String   // office | seller
  sellerId  String?  // solo role = seller
  data      String   // JSON de la suscripción (endpoint + claves)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([endpoint, role])
  @@index([role, sellerId])
}

// Ajustes internos del servidor (claves VAPID de las notificaciones push,
// generadas una sola vez por el propio servidor).
model DistSetting {
  name  String @id
  value String
}

// Kardex de vacíos (Fase 2 · E4): un renglón por movimiento. Solo se agregan;
// nunca se editan ni se borran (lo impide un disparador en la base). Un error
// se corrige con otro renglón (anulación / reverso) que apunta al original.
//   despacho | recibido | asignado → los escribe el servidor al cerrar una liquidación
//   devolucion | dev_asignado | apertura | apertura_asig → los registra la oficina
//   anulacion (oficina) | reverso (liquidación reabierta) → cancelan a refId
model DistVacMov {
  id         String   @id
  at         DateTime @default(now())
  date       String   // día del movimiento (YYYY-MM-DD)
  kind       String
  clientId   String
  clientName String
  sellerId   String   @default("")
  sellerName String   @default("")
  type       String   // tipo de envase (350, 1,25…): el saldo se lleva por tipo
  pid        String   @default("")
  code       String   @default("")
  qty        Int
  orderId    String?
  loadId     String?
  refId      String?
  motivo     String   @default("")
  by         String   @default("")
  data       String   @default("{}")

  @@index([clientId])
  @@index([orderId])
  @@index([refId])
}
